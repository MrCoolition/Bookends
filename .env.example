# Copy placeholders into a local ignored env file or Vercel environment settings.
# Never place real credentials in this tracked example.
# Keep preview and production databases, identities, and secrets separate.
BOOKENDS_ENV=development
BOOKENDS_MODE=demo
BOOKENDS_ADMIN_MODE=local

# Interim shared workspace: set BOOKENDS_ADMIN_MODE=shared after running migration 0004.
# Run npx tsx scripts/create-workspace-secrets.ts to create ignored private credentials.
# Passcode and sessions grant this workspace only; they do not grant OIDC identity access.
BOOKENDS_WORKSPACE_ORIGIN=https://your-bookends-host.example
BOOKENDS_WORKSPACE_ID=main
BOOKENDS_WORKSPACE_PASSCODE_HASH=
BOOKENDS_WORKSPACE_SESSION_SECRET=
# Optional separate restricted login; if empty, shared mode uses DATABASE_URL below.
BOOKENDS_SHARED_DATABASE_URL=

# SOW reading only: the explicit Read action calls OpenAI Responses directly.
# Existing Vercel secret chaz_gpt is preferred; OPENAI_API_KEY is a local fallback.
# Neither key is public. Do not prefix either with NEXT_PUBLIC_.
BOOKENDS_AI_MODEL=gpt-6.1-sol
BOOKENDS_AI_ENABLED=true
chaz_gpt=
OPENAI_API_KEY=

# Public canonical HTTPS origin; OIDC callback is /api/auth/callback/corporate.
AUTH_URL=https://your-bookends-host.example
AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
AUTH_OIDC_ISSUER=https://your-organization-issuer.example
AUTH_OIDC_CLIENT_ID=replace-with-client-id
AUTH_OIDC_CLIENT_SECRET=replace-with-client-secret

# Least-privilege LOGIN inheriting be_runtime; cannot own tables or bypass RLS.
DATABASE_URL=postgresql://bookends_app:replace-password@your-host.example/bookends?sslmode=verify-full

# Administration only: direct endpoint. Do not add this to the web deployment.
MIGRATION_DATABASE_URL=postgresql://bookends_migrator:replace-password@your-direct-host.example/bookends?sslmode=verify-full
